# =============================================================================
# Mashwara AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# Google Gemini API key (required)
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Comma-separated list of allowed CORS origins (optional, defaults to * in dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate limit for POST /meeting endpoint (optional, default: 5/minute)
RATE_LIMIT=5/minute

# Database URL (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-muddy-frog-adaf15fz-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT Configuration
JWT_SECRET_KEY=your_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Google Identity Services (Client ID only)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Neon Auth Configuration (optional legacy)
NEON_AUTH_URL=https://ep-muddy-frog-adaf15fz.neonauth.c-2.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-muddy-frog-adaf15fz.neonauth.c-2.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
