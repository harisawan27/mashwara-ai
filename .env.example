# =============================================================================
# Mashwara AI — Environment Variables
# =============================================================================

# Google Gemini API key (required)
GOOGLE_API_KEY=your_google_api_key_here

# Database URL (Neon PostgreSQL)
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-muddy-frog-adaf15fz-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT Configuration
JWT_SECRET_KEY=your_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Neon Auth Configuration (Google Social Authentication)
NEON_AUTH_URL=https://ep-muddy-frog-adaf15fz.neonauth.c-2.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-muddy-frog-adaf15fz.neonauth.c-2.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
